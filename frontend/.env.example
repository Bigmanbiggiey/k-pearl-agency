# Frontend environment — public, non-sensitive values only (docs/deployment.md).
# Copy to `frontend/.env` and fill in. Never put the Supabase service-role key,
# SMTP passwords, or any private API key in a VITE_-prefixed variable — they
# ship to the browser.

# Supabase project URL.
#  - local dev:   http://127.0.0.1:55321  (from `npx supabase status`)
#  - production:  https://<project-ref>.supabase.co  (Supabase → Project Settings → API)
VITE_SUPABASE_URL=

# Supabase anon / public key (safe to expose — RLS is the security boundary).
#  - local dev:   the anon key printed by `npx supabase status`
#  - production:  Supabase → Project Settings → API → "anon public"
VITE_SUPABASE_ANON_KEY=
